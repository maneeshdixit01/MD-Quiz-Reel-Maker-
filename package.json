{
  "name": "md-quiz-reel-maker",
  "version": "7.0.0",
  "description": "Quiz Video Maker for 9:16 Reels/Shorts and 16:9 YouTube Landscape (Manual + PDF + Voice Recording + Hindi TTS + Outro + MP4 Export)",
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.mkdirSync('www',{recursive:true}); ['index.html','manifest.webmanifest'].forEach(f=>fs.copyFileSync(f,'www/'+f));\""
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}